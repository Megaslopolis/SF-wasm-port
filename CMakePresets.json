{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 / Visual Studio 2026",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "SF_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-psycross",
      "displayName": "Windows x64 / Visual Studio 2026 / PsyCross",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/build/windows-psycross",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "SF_ENABLE_PSYCROSS": "ON"
      }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly / Emscripten / PsyCross (movies stubbed)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm",
      "toolchainFile": "${sourceDir}/cmake/toolchain-emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SF_ENABLE_PSYCROSS": "ON",
        "SF_ENABLE_MEDIA": "OFF",
        "SF_BUILD_TESTS": "OFF",
        "SF_BUILD_ROM_PROBES": "OFF",
        "SF_ENABLE_RELEASE_IPO": "OFF",
        "SF_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "wasm-media",
      "displayName": "WebAssembly / Emscripten / PsyCross (movies; needs SF_WASM_FFMPEG_ROOT)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm-media",
      "toolchainFile": "${sourceDir}/cmake/toolchain-emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SF_ENABLE_PSYCROSS": "ON",
        "SF_ENABLE_MEDIA": "ON",
        "SF_BUILD_TESTS": "OFF",
        "SF_BUILD_ROM_PROBES": "OFF",
        "SF_ENABLE_RELEASE_IPO": "OFF",
        "SF_WARNINGS_AS_ERRORS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "windows-psycross-release",
      "configurePreset": "windows-psycross",
      "configuration": "Release"
    },
    {
      "name": "windows-core-release",
      "displayName": "Windows Release / core game only",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "targets": ["sf_game"]
    },
    {
      "name": "windows-psycross-app-release",
      "displayName": "Windows Release / playable app only",
      "configurePreset": "windows-psycross",
      "configuration": "Release",
      "targets": ["syphon_filter"]
    },
    {
      "name": "wasm-shell",
      "displayName": "WASM / browser game shell",
      "configurePreset": "wasm",
      "targets": ["sf_wasm_shell"]
    },
    {
      "name": "wasm-media-shell",
      "displayName": "WASM / browser game shell with movies",
      "configurePreset": "wasm-media",
      "targets": ["sf_wasm_shell"]
    },
    {
      "name": "wasm-portable",
      "displayName": "WASM / portable core + sf_tool compile check",
      "configurePreset": "wasm",
      "targets": ["sf_tool"]
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-psycross-release",
      "configurePreset": "windows-psycross",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
